# ============================================================
# UNIFORM QUANTIZER  (fixed-range version, reused by PCM and DPCM)
# ============================================================

def uniform_quantizer(x, xmin, xmax, levels):
    """
    Uniform quantizer over an explicit fixed range [xmin, xmax].
    Works on scalars or arrays. Returns (quantized_value, step_size).
    """
    step = (xmax - xmin) / (levels - 1)
    x_clipped = np.clip(x, xmin, xmax)
    q_index = np.round((x_clipped - xmin) / step)
    xq = xmin + q_index * step
    return xq, step


# ============================================================
# PCM IMPLEMENTATION
# ============================================================

def PCM(signal, levels):
    xmin, xmax = np.min(signal), np.max(signal)
    quantized, step = uniform_quantizer(signal, xmin, xmax, levels)
    error = signal - quantized
    mse = np.mean(error**2)
    return quantized, error, mse


# ============================================================
# FIRST ORDER DPCM  (fixed: proper causal feedback loop)
# ============================================================

def DPCM(signal, levels):
    """
    Correct closed-loop first-order DPCM:

        predicted[n]     = reconstructed[n-1]     <- previous RECONSTRUCTED
                                                       sample, not raw signal
        error[n]         = signal[n] - predicted[n]
        q_error[n]       = quantize(error[n])
        reconstructed[n] = predicted[n] + q_error[n]

    (Previous bug: predicted[] was computed for the whole array before any
    reconstruction existed, so it read back zeros instead of the previous
    reconstructed sample. That silently turned DPCM into "predict zero",
    which is why it gave no real advantage over PCM. Fixed by running
    prediction -> quantization -> reconstruction sample-by-sample in one
    causal loop.)
    """
    N = len(signal)

    predicted        = np.zeros(N)
    prediction_error = np.zeros(N)
    quantized_error  = np.zeros(N)
    reconstructed    = np.zeros(N)

    reconstructed[0] = signal[0]

    # The quantizer's range for the prediction error can't be measured
    # causally one sample at a time, so estimate a fixed range up front
    # from the signal's first difference (a standard simplification).
    approx_error = np.diff(signal)
    e_min, e_max = np.min(approx_error), np.max(approx_error)
    step = (e_max - e_min) / (levels - 1)

    for n in range(1, N):
        predicted[n] = reconstructed[n-1]
        prediction_error[n] = signal[n] - predicted[n]

        q_index = np.round((np.clip(prediction_error[n], e_min, e_max) - e_min) / step)
        quantized_error[n] = e_min + q_index * step

        reconstructed[n] = predicted[n] + quantized_error[n]

    mse = np.mean((signal - reconstructed)**2)

    return predicted, prediction_error, quantized_error, reconstructed, mse


# ============================================================
# DELTA MODULATION
# ============================================================

def delta_modulation(signal, delta):
    N = len(signal)
    staircase = np.zeros(N)
    bits = np.zeros(N)

    for n in range(1, N):
        if signal[n] >= staircase[n-1]:
            staircase[n] = staircase[n-1] + delta
            bits[n] = 1
        else:
            staircase[n] = staircase[n-1] - delta
            bits[n] = 0

    mse = np.mean((signal - staircase)**2)
    return bits, staircase, mse


# ============================================================
# ADAPTIVE DELTA MODULATION
# ============================================================

def adaptive_delta_modulation(signal, delta):
    N = len(signal)
    staircase = np.zeros(N)
    bits = np.zeros(N)
    adaptive_delta = delta

    for n in range(1, N):
        if signal[n] >= staircase[n-1]:
            staircase[n] = staircase[n-1] + adaptive_delta
            bits[n] = 1
        else:
            staircase[n] = staircase[n-1] - adaptive_delta
            bits[n] = 0

        if n > 1:
            if bits[n] == bits[n-1]:
                adaptive_delta *= 1.1   # same direction twice -> ramp up (slope overload)
            else:
                adaptive_delta *= 0.9   # direction flipped -> ramp down (granular noise)

    mse = np.mean((signal - staircase)**2)
    return staircase, mse


